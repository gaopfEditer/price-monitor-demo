{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": ["data/demo_readonly.db", "data/evidence/**"]
      }
    }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "api/index.py" },
    { "src": "/(.*)", "dest": "api/index.py" }
  ],
  "env": {
    "DATABASE_URL": "sqlite:////tmp/demo_readonly.db",
    "DEMO_MODE": "1",
    "READONLY": "1",
    "SANDBOX_BASE_URL": "http://127.0.0.1:8001"
  }
}
